# Copy to .env (never commit .env). All values are optional; defaults live in config/settings.yaml
AIOPS_MODE=local                       # local = read Prometheus directly | api = use the FastAPI backend
AIOPS_PROM_URL=http://localhost:9090   # Prometheus of the OpenTelemetry demo
AIOPS_API_URL=http://localhost:8000/api/v1
AIOPS_API_TOKEN=                       # JWT, only for api mode
# Only set these on the machine that runs the demo (sandbox control). Leave empty elsewhere.
AIOPS_DEMO_DIR=                        # e.g. /home/user/opentelemetry-demo
AIOPS_COMPOSE_FILE=                    # only if the demo was started with a non-default file, e.g. docker-compose.minimal.yml
AIOPS_EXECUTOR_ENABLED=false           # true lets approved, allow-listed remedies run in the sandbox
